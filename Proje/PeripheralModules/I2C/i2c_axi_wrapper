`timescale 1ns / 1ps

module i2c_axi_wrapper #(
    parameter SYS_CLK = 50_000_000,
    parameter SCL_CLK = 400_000
)(
    input wire clk,
    input wire rst_n, //aktif düşük reset

    output wire o_scl,
    output wire o_sda_out,
    output wire o_sda_oe,
    input  wire i_sda_in,

    // AXI4-Lite Arayüzü
    input wire AWVALID,
    output wire AWREADY,
    input wire [31:0] AWADDR,

    input wire WVALID,
    output wire WREADY,
    input wire [31:0] WDATA,
    input wire [3:0] WSTRB,

    output wire BVALID,
    input wire BREADY,
    output wire [1:0] BRESP,

    input wire ARVALID,
    output wire ARREADY,
    input wire [31:0] ARADDR,

    output wire RVALID,
    input wire RREADY,
    output wire [31:0] RDATA
);

    // memory map
    localparam ADDR_I2C_NBY = 32'h00007000,
               ADDR_I2C_ADR = 32'h00007004,
               ADDR_I2C_RDR = 32'h00007008,
               ADDR_I2C_TDR = 32'h0000700C,
               ADDR_I2C_CFG = 32'h00007010;

    // regs
    reg [31:0] I2C_NBY;
    reg [31:0] I2C_ADR;
    reg [31:0] I2C_TDR;
    reg [31:0] I2C_CFG;
    
    wire [31:0] core_rx_data;
    wire core_tx_done, core_rx_done, core_busy;

    reg axi_awready;
    reg [31:0] axi_rdata;
    reg axi_bvalid, axi_rvalid;
    reg axi_rready;

    assign BRESP   = 2'b00;
    assign BVALID  = axi_bvalid;
    assign RVALID  = axi_rvalid;
    assign RDATA   = axi_rdata;
    assign WREADY  = axi_awready;
    assign AWREADY = axi_awready;
    assign ARREADY = axi_rready;
    
    wire axi_write_ready = axi_awready;
    wire axi_read_ready  = (ARVALID && ARREADY);

    // I2C Master
    I2C_master #(
        .CLK_FREQ(SYS_CLK),
        .I2C_FREQ(SCL_CLK)
    ) i2c_core_inst (
        .clk(clk),
        .rst_n(rst_n),
        .i_slave_addr(I2C_ADR[6:0]),
        .i_tx_data(I2C_TDR),
        .o_rx_data(core_rx_data),
        .i_num_bytes(I2C_NBY[2:0]),
        .i_tx_en(I2C_CFG[0]),
        .o_tx_done(core_tx_done),
        .i_rx_en(I2C_CFG[2]),
        .o_rx_done(core_rx_done),
        .o_busy(core_busy),
        .o_scl(o_scl),
        .o_sda_out(o_sda_out),
        .o_sda_oe(o_sda_oe),
        .i_sda_in(i_sda_in)
    );

    // Write
    always @(posedge clk) begin
        if(!rst_n) begin
            I2C_NBY <= 32'b0;
            I2C_ADR <= 32'b0;
            I2C_TDR <= 32'b0;
            I2C_CFG <= 32'b0;
        end else begin
            // Status bits
            I2C_CFG[1] <= core_tx_done; 
            I2C_CFG[3] <= core_rx_done;
            I2C_CFG[4] <= core_busy;

            if (axi_write_ready) begin
                case(AWADDR)
                    ADDR_I2C_NBY: begin
                        if(WSTRB[0]) I2C_NBY[7:0]   <= WDATA[7:0];
                        if(WSTRB[1]) I2C_NBY[15:8]  <= WDATA[15:8];
                        if(WSTRB[2]) I2C_NBY[23:16] <= WDATA[23:16];
                        if(WSTRB[3]) I2C_NBY[31:24] <= WDATA[31:24];
                    end
                    ADDR_I2C_ADR: begin
                        if(WSTRB[0]) I2C_ADR[7:0]   <= WDATA[7:0];
                        if(WSTRB[1]) I2C_ADR[15:8]  <= WDATA[15:8];
                        if(WSTRB[2]) I2C_ADR[23:16] <= WDATA[23:16];
                        if(WSTRB[3]) I2C_ADR[31:24] <= WDATA[31:24];
                    end
                    ADDR_I2C_TDR: begin
                        if(WSTRB[0]) I2C_TDR[7:0]   <= WDATA[7:0];
                        if(WSTRB[1]) I2C_TDR[15:8]  <= WDATA[15:8];
                        if(WSTRB[2]) I2C_TDR[23:16] <= WDATA[23:16];
                        if(WSTRB[3]) I2C_TDR[31:24] <= WDATA[31:24];
                    end
                    ADDR_I2C_CFG: begin
                        if(WSTRB[0]) begin
                            I2C_CFG[0] <= WDATA[0]; // TX_EN
                            I2C_CFG[2] <= WDATA[2]; // RX_EN
                        end
                        if(WSTRB[1]) I2C_CFG[15:8]  <= WDATA[15:8];
                        if(WSTRB[2]) I2C_CFG[23:16] <= WDATA[23:16];
                        if(WSTRB[3]) I2C_CFG[31:24] <= WDATA[31:24];
                    end
                endcase
            end else if (core_busy) begin
                I2C_CFG[0] <= 1'b0;
                I2C_CFG[2] <= 1'b0;
            end
        end
    end

    // Read
    always @(posedge clk) begin
        if(!rst_n)
            axi_rdata <= 32'b0;
        else if(!ARVALID || RREADY) begin
            case(ARADDR)
                ADDR_I2C_NBY: axi_rdata <= I2C_NBY;
                ADDR_I2C_ADR: axi_rdata <= I2C_ADR;
                ADDR_I2C_RDR: axi_rdata <= core_rx_data;
                ADDR_I2C_TDR: axi_rdata <= I2C_TDR;
                ADDR_I2C_CFG: axi_rdata <= I2C_CFG;
                default:      axi_rdata <= 32'h0;
            endcase
        end
    end

    // AXI Handshaking Signals
    initial axi_bvalid = 1'b0;
    always@(posedge clk) begin
        if(!rst_n)
            axi_bvalid <= 1'b0;
        else if(axi_write_ready)
            axi_bvalid <= 1'b1;
        else if(BREADY)
            axi_bvalid <= 1'b0;
    end

    initial axi_rvalid = 1'b0;
    always@(posedge clk) begin
        if(!rst_n)
            axi_rvalid <= 1'b0;
        else if(axi_read_ready)
            axi_rvalid <= 1'b1;
        else if(RREADY)
            axi_rvalid <= 1'b0;
    end

    initial axi_awready = 1'b0;
    always@(posedge clk) begin
        if(!rst_n)
            axi_awready <= 1'b0;
        else 
            axi_awready <= !axi_awready && (AWVALID && WVALID) && (!BVALID && BREADY);
    end

    always@(*) begin
        axi_rready = !RVALID;
    end

endmodule
