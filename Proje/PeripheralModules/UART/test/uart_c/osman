#!/bin/bash

riscv64-unknown-elf-gcc -g -march=rv32imc_zicsr_zifencei -mabi=ilp32 -T link.ld -nostartfiles -nostdlib crt0.S main.c uart.c qspi.c -o system.elf

riscv64-unknown-elf-objdump -d system.elf > system.asm

riscv64-unknown-elf-objcopy -O verilog system.elf system.mem

riscv64-unknown-elf-objcopy -O binary system.elf program.bin

echo "@00000000" > osman.txt

python3 osman.py >> osman.txt


